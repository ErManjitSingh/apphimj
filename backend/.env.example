PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/travel_crm

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=30d

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173

SEED_PASSWORD=123456

# Optional — shared cache (falls back to in-memory if unavailable)
REDIS_URL=redis://127.0.0.1:6379

# Web Push (multi-device notifications) — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Optional email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Travel CRM

# Optional IMAP reply tracking
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# EMAIL_INBOX_POLL_MS=300000

# Optional hotel package catalog
# UNO_HOTELS_API_BASE_URL=https://api.unohotelsandresorts.com
# UNO_HOTELS_ADMIN_TOKEN=
# UNO_HOTELS_ADMIN_EMAIL=
# UNO_HOTELS_ADMIN_PASSWORD=
# UNO_HOTELS_OPS_USERNAME=
# UNO_HOTELS_OPS_PASSWORD=
# UNO_HOTELS_RATE_OVERRIDE_CHANNEL=staff
